; Хронометър — Godot 4 разузнавателен проект
;
; Чете СЪЩИТЕ данни за трасетата като браузърната версия
; (public/game/tracks/*.json), за да е сравнението честно: една и съща
; геометрия, един и същ модел на физиката, различен рендерер.
;
; Сцената се сглобява изцяло в код (main.gd) вместо в .tscn — така проектът
; е четим в git diff и не зависи от ръчно писан формат на сцена.

config_version=5

[application]

config/name="Хронометър"
config/description="Разузнавателен Godot билд на играта от padok.bg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[physics]

; Симулацията върви на фиксирани 120 Hz, както в браузърната версия.
; Времената на обиколките се броят в стъпки, не по стенен часовник — това е
; предпоставката за сървърна валидация на класацията по-късно.
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
3d/default_gravity=0.0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
global_illumination/sdfgi/probe_ray_count=2
global_illumination/gi/use_half_resolution=true
textures/default_filters/anisotropic_filtering_level=3
