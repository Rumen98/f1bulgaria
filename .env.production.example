# Падок — production environment template.
# Копирай в .env на сървъра и попълни тайните. НЕ commit-вай реалния .env.

APP_NAME="Падок"
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://padok.bg

# Админ акаунт за /admin: задай двете и пусни `php artisan padok:sync-admin`
# (паролата влиза в базата като hash; пускай командата след всяка промяна).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# (По избор) Скрита врата: с ключ /admin връща 404 без ?key=СТОЙНОСТТА.
# Празно = изключена. Генериране: php -r "echo bin2hex(random_bytes(32));"
ADMIN_ACCESS_KEY=

APP_LOCALE=bg
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bg_BG

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# По-малко шум в production.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=f1bulgaria
DB_USERNAME=                  # dedicated DB user (НЕ root)
DB_PASSWORD=                  # силна парола

# Един сървър (Hetzner): database драйверите вършат работа. Redis е по избор.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true    # HTTPS only

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# Поща — реален SMTP за потвърждения (newsletter double opt-in, верификация).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="no-reply@padok.bg"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Външни услуги (попълни само ако се ползват) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
WIKIPEDIA_USER_AGENT="Padok/1.0 (https://padok.bg)"

# --- V1 launch feature flags (config/features.php) ---
# Всички V2 модули са изключени за launch. Включи при готовност — без code change.
FEATURE_COMPARE=false
FEATURE_RIVALRIES=false
FEATURE_CIRCUITS=false
FEATURE_TSOLOV=false
FEATURE_HISTORY=false
FEATURE_F2=false
FEATURE_LIVE_TIMING=false
FEATURE_THIS_DAY=false
